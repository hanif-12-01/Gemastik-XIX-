# EcoThread System Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Runtime Environment ──────────────────────────────────────────────────────
# development | preview | production
DEPLOYMENT_ENV=development
NODE_ENV=development

# ─── API Server (local dev only — not used in Vercel) ─────────────────────────
PORT=4000
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
# For local dev: Docker Compose PostgreSQL
# For Vercel Preview: Neon Preview branch pooled URL
# For Vercel Production: Neon Production branch pooled URL
DATABASE_URL="postgresql://ecothread:ecothread@localhost:5432/ecothread_dev?schema=public"

# DIRECT_URL used by Prisma Migrate — must be non-pooled (Neon direct connection)
DIRECT_URL="postgresql://ecothread:ecothread@localhost:5432/ecothread_dev?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED: Use a strong random secret in Preview and Production
# Generate: openssl rand -hex 64
JWT_SECRET=ecothread-dev-secret-key-change-me-in-production
JWT_EXPIRES_IN=8h

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Preview: set to your Vercel Preview web URL
# Production: set to your Vercel Production web URL
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:3000

# ─── URL Configuration ────────────────────────────────────────────────────────
# WEB_APP_URL — used SERVER-SIDE by the API for:
#   - Admin invitation URLs
#   - DPP QR Code target URL
# Must be the full deployed web URL (no trailing slash)
# Preview:    https://ecothread-web-preview.vercel.app
# Production: https://ecothread.vercel.app (or custom domain)
WEB_APP_URL=http://localhost:3000

# ─── Vercel Blob Storage ──────────────────────────────────────────────────────
# Single-store setup: BLOB_READ_WRITE_TOKEN covers both public and private blobs
# Two-store setup: use PRIVATE_BLOB_READ_WRITE_TOKEN for private uploads
BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Max file size for private uploads (bytes). Default: 5242880 (5 MB)
PRIVATE_UPLOAD_MAX_BYTES=5242880

# ─── Application Version ──────────────────────────────────────────────────────
# Set automatically by Vercel from VERCEL_GIT_COMMIT_SHA
# Or set manually for local dev
APP_VERSION=dev

# ─── Frontend (Vite Build Variables — Web App) ───────────────────────────────
# These are injected at BUILD time and become PUBLIC in the browser bundle.
# NEVER put secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_URL=http://localhost:3000
VITE_ENVIRONMENT=development

# ─── Production Migration Guard ───────────────────────────────────────────────
# Set this to allow running db:migrate:production
# Must match exactly: ECOTHREAD_PROD_MIGRATE_YES
PRODUCTION_MIGRATION_CONFIRM=

# ─── Test Database (local E2E — Do Not Set in Production) ────────────────────
DATABASE_TEST_URL="postgresql://ecothread:ecothread@localhost:5432/ecothread_test?schema=public"

# ─── Local Dev Only (Not Used by Vercel) ─────────────────────────────────────
DPP_PUBLIC_BASE_URL=http://localhost:3000
AI_WORKER_URL=http://localhost:8000

{
  "name": "ecothread-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "lint": "pnpm --filter \"*\" lint",
    "test": "pnpm --filter \"*\" test",
    "web:dev": "pnpm --filter @ecothread/web dev",
    "web:build": "pnpm --filter @ecothread/web build",
    "web:typecheck": "pnpm --filter @ecothread/web typecheck",
    "web:lint": "pnpm --filter @ecothread/web lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0"
  }
}
